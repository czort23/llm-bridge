{
  "name": "@omnillm/openai-compatible",
  "version": "0.0.0",
  "description": "Base provider and Chat Completions mapping for OpenAI-compatible APIs (omnillm).",
  "keywords": [
    "llm",
    "ai",
    "typescript",
    "omnillm",
    "openai"
  ],
  "license": "MIT",
  "author": "Adrian Załubski <czort.coding+omnillm@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czort23/omnillm.git",
    "directory": "packages/openai-compatible"
  },
  "homepage": "https://github.com/czort23/omnillm#readme",
  "bugs": "https://github.com/czort23/omnillm/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omnillm/core": "workspace:*"
  }
}
