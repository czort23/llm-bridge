{
  "name": "@omnillm/core",
  "version": "0.0.0",
  "description": "Core interfaces, errors, and resilience helpers for omnillm — a unified TypeScript client for LLM providers.",
  "keywords": [
    "llm",
    "ai",
    "typescript",
    "omnillm"
  ],
  "license": "MIT",
  "author": "Adrian Załubski <czort.coding+omnillm@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czort23/omnillm.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/czort23/omnillm#readme",
  "bugs": "https://github.com/czort23/omnillm/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs",
    "typecheck": "tsc --noEmit"
  }
}
